  $BWDSTART = FALSE
  PDAT_ACT=PDEFAULT
  FDAT_ACT=FHOME
  BAS (#PTP_PARAMS,100 )
  $H_POS=XHOME
  PTP  XHOME
  ;ENDFOLD
  GripOpen()

