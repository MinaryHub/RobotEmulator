  $BWDSTART=FALSE
  PDAT_ACT=PPDAT4
  FDAT_ACT=FP7
  BAS(#PTP_PARAMS,100)
  PTP XP7
  ;ENDFOLD
  ;FOLD LIN P8 Vel=0.3 m/s CPDAT7 Tool[1]:gripper Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P8, 3:, 5:0.3, 7:CPDAT7
  $BWDSTART=FALSE
