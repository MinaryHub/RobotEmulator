&ACCESS RVP
&REL 1
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program
DEF pick_place( )
; KR 6 R900 sixx (AGILUS) 픽 앤 플레이스 예제 (RobotEmulator 자동 생성)
; 그리퍼: Robotiq 2F-85 Adaptive
; $OUT[1]=그리퍼 닫기, $OUT[2]=그리퍼 열기, $IN[1]=닫힘 확인, $IN[2]=열림 확인
  ;FOLD INI;%{PE}
    ;FOLD BASISTECH INI
      GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
      INTERRUPT ON 3 
      BAS (#INITMOV,0 )
    ;ENDFOLD (BASISTECH INI)
    ;FOLD USER INI
      ;Make your modifications here
      nPart = 0
    ;ENDFOLD (USER INI)
  ;ENDFOLD (INI)

