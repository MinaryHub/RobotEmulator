Hyundai Robot Job File; { version: 1.6, mech_type: "HH7 (HDF7-9)", total_axis: 6, aux_axis: 0 }
     ' 픽 앤 플레이스 예제 — 공작물 W1~W4 를 Y 대칭 위치로 이송
     ' P1~P4: 픽 위치, P11~P14: 플레이스 위치, P99: 접근 오프셋, P100: 대기 위치(관절)
     S1   MOVE P,P100,S=50%,A=0,T=0
     CALL 3                          ' 그리퍼 열기
     V1%=0
     FOR V2%=1 TO 4
       P90=P[V2%]+P99                ' 픽 접근점
       P91=P[V2%+10]+P99             ' 플레이스 접근점
     S2   MOVE P,P90,S=60%,A=3,T=0
     S3   MOVE L,P[V2%],S=200mm/sec,A=0,T=0
       CALL 2                        ' 그리퍼 닫기
       IF DI3=0 THEN *NOPART
     S4   MOVE L,P90,S=500mm/sec,A=3,T=0
     S5   MOVE P,P91,S=60%,A=3,T=0
     S6   MOVE L,P[V2%+10],S=200mm/sec,A=0,T=0
       CALL 3
     S7   MOVE L,P91,S=500mm/sec,A=3,T=0
       V1%=V1%+1
     NEXT
     S8   MOVE P,P100,S=50%,A=0,T=0
     PRINT "완료: ", V1%, " 개 이송"
     GOTO *FIN
     *NOPART
     PRINT "공작물 미검출 — 정지"
     CALL 3
     STOP
     *FIN
     END
P1={512.600,-279.600,20.000,180.000,0.000,180.000,"base"}
P2={512.600,-93.200,20.000,180.000,0.000,180.000,"base"}
P3={512.600,93.200,20.000,180.000,0.000,180.000,"base"}
P4={512.600,279.600,20.000,180.000,0.000,180.000,"base"}
P11={354.000,279.600,21.000,180.000,0.000,180.000,"base"}
P12={354.000,93.200,21.000,180.000,0.000,180.000,"base"}
P13={354.000,-93.200,21.000,180.000,0.000,180.000,"base"}
P14={354.000,-279.600,21.000,180.000,0.000,180.000,"base"}
P99={0.000,0.000,100.000,0.000,0.000,0.000,"base"}
P100={0.000,90.000,0.000,0.000,-90.000,0.000,"axis"}
