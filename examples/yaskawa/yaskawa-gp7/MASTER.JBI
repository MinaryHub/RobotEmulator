/JOB
//NAME MASTER
//POS
///NPOS 17,0,0,0,0,0
///TOOL 0
///POSTYPE PULSE
///PULSE
C00000=0,0,0,0,-92070,0
///TOOL 0
///POSTYPE BASE
///RECTAN
///RCONF 0,0,0,0,0,0,0,0
C00001=509.850,-278.100,120.000,180.0000,0.0000,180.0000
C00002=509.850,-278.100,20.000,180.0000,0.0000,180.0000
C00003=352.000,278.100,121.000,180.0000,0.0000,180.0000
C00004=352.000,278.100,21.000,180.0000,0.0000,180.0000
C00005=509.850,-92.700,120.000,180.0000,0.0000,180.0000
C00006=509.850,-92.700,20.000,180.0000,0.0000,180.0000
C00007=352.000,92.700,121.000,180.0000,0.0000,180.0000
C00008=352.000,92.700,21.000,180.0000,0.0000,180.0000
C00009=509.850,92.700,120.000,180.0000,0.0000,180.0000
C00010=509.850,92.700,20.000,180.0000,0.0000,180.0000
C00011=352.000,-92.700,121.000,180.0000,0.0000,180.0000
C00012=352.000,-92.700,21.000,180.0000,0.0000,180.0000
C00013=509.850,278.100,120.000,180.0000,0.0000,180.0000
C00014=509.850,278.100,20.000,180.0000,0.0000,180.0000
C00015=352.000,-278.100,121.000,180.0000,0.0000,180.0000
C00016=352.000,-278.100,21.000,180.0000,0.0000,180.0000
//INST
///DATE 2026/10/09 19:37
///COMM PICK AND PLACE W1-W4
///ATTR SC,RW
///GROUP1 RB1
NOP
'픽 앤 플레이스: 공작물 W1~W4 를 Y 대칭 위치로 이송
SET I000 0
CALL JOB:HAND_OPEN
MOVJ C00000 VJ=25.00
'---- W1 ----
MOVJ C00001 VJ=50.00 PL=3
MOVL C00002 V=200.0 PL=0
CALL JOB:HAND_CLOSE
JUMP *NOPART IF IN#(3)=OFF
MOVL C00001 V=500.0 PL=3
MOVJ C00003 VJ=50.00 PL=3
MOVL C00004 V=200.0 PL=0
CALL JOB:HAND_OPEN
MOVL C00003 V=500.0 PL=3
INC I000
'---- W2 ----
MOVJ C00005 VJ=50.00 PL=3
MOVL C00006 V=200.0 PL=0
CALL JOB:HAND_CLOSE
JUMP *NOPART IF IN#(3)=OFF
MOVL C00005 V=500.0 PL=3
MOVJ C00007 VJ=50.00 PL=3
MOVL C00008 V=200.0 PL=0
CALL JOB:HAND_OPEN
MOVL C00007 V=500.0 PL=3
INC I000
'---- W3 ----
MOVJ C00009 VJ=50.00 PL=3
MOVL C00010 V=200.0 PL=0
CALL JOB:HAND_CLOSE
JUMP *NOPART IF IN#(3)=OFF
MOVL C00009 V=500.0 PL=3
MOVJ C00011 VJ=50.00 PL=3
MOVL C00012 V=200.0 PL=0
CALL JOB:HAND_OPEN
MOVL C00011 V=500.0 PL=3
INC I000
'---- W4 ----
MOVJ C00013 VJ=50.00 PL=3
MOVL C00014 V=200.0 PL=0
CALL JOB:HAND_CLOSE
JUMP *NOPART IF IN#(3)=OFF
MOVL C00013 V=500.0 PL=3
MOVJ C00015 VJ=50.00 PL=3
MOVL C00016 V=200.0 PL=0
CALL JOB:HAND_OPEN
MOVL C00015 V=500.0 PL=3
INC I000
MOVJ C00000 VJ=25.00
MSG "PICK & PLACE COMPLETE"
JUMP *FIN
*NOPART
MSG "WORKPIECE NOT DETECTED"
CALL JOB:HAND_OPEN
PAUSE
*FIN
END
